#!/usr/bin/env ruby
# Runs mutant on every subject in config/mutant.yml and fails unless what
# survives is exactly what test/mutant/baseline.yml accepts. See PRODUCT.md,
# "Contract: continuous integration".
#
#   bin/mutant-floor [BASE]              check against BASE's baseline (default $CI_BASE, else origin/main)
#   bin/mutant-floor --record "REASON"   re-anchor the baseline on this run's survivors
require "date"
require "fileutils"
require "open3"
require_relative "../test/mutant/floor"

APP_ROOT = File.expand_path("..", __dir__)
LOG = "log/mutant-floor.log"

HEADER = <<~YAML
  # Mutation survivors bin/ci accepts, by subject: the lines each mutation
  # removes and adds. A survivor not listed here fails the build, and so does
  # an entry whose mutation a test now kills or mutant no longer makes.
  # `subjects` lists every subject that ran when this was recorded; one that
  # no longer runs (moved into a concern, renamed) fails the build too.
  #
  # Re-anchor only with `bin/mutant-floor --record "REASON"`, which runs every
  # subject and appends an anchor; a change to the survivors without a new
  # anchor and its reason fails the build. Say in the reason why each new
  # survivor is equivalent, or why it is accepted anyway.
YAML

def git(*args)
  out, status = Open3.capture2("git", *args)
  abort "mutant-floor: git #{args.join(" ")} failed" unless status.success?
  out
end

def base_baseline(merge_base)
  out, status = Open3.capture2("git", "show", "#{merge_base}:#{MutantFloor::BASELINE}", err: File::NULL)
  YAML.safe_load(out) if status.success?
end

def run_mutant
  system({ "RAILS_ENV" => "test" }, "bin/rails", "db:test:prepare", exception: true)
  before = Dir[".mutant/results/*.json"]
  output, = Open3.capture2e("bundle", "exec", "mutant", "run")
  File.write(LOG, output)
  session = (Dir[".mutant/results/*.json"] - before).first
  abort "#{output}\nmutant-floor: mutant wrote no session result" unless session
  # mutant's summary, without the diff of every survivor the baseline holds
  puts output[(output.rindex(/^Mutant environment:/) || 0)..], "(mutant's full output: #{LOG})"
  JSON.parse(File.read(session))
end

def list(heading, entries)
  return if entries.empty?

  puts heading
  entries.each do |entry|
    case entry
    in MutantFloor::Survivor then puts "  #{entry.subject}  #{entry.identification}", entry.change.gsub(/^/, "    ")
    in [ subject, change ] then puts "  #{subject}", change.gsub(/^/, "    ")
    in String then puts "  #{entry}"
    end
  end
end

FileUtils.chdir APP_ROOT do
  baseline = File.exist?(MutantFloor::BASELINE) ? YAML.load_file(MutantFloor::BASELINE) : {}

  if ARGV.first == "--record"
    reason = ARGV[1].to_s.strip
    abort "usage: bin/mutant-floor --record \"REASON\"" if reason.empty?
    session = run_mutant
    at = git("rev-parse", "--short", "HEAD").strip
    recorded = MutantFloor.record(session, baseline, at:, on: Date.today.iso8601, reason:)
    File.write(MutantFloor::BASELINE, HEADER + YAML.dump(recorded, line_width: -1))
    puts "mutant-floor: recorded #{recorded["survivors"].values.sum(&:size)} survivors at #{at}"
    exit
  end

  base = ARGV.first || ENV["CI_BASE"].to_s.then { |ref| ref.empty? ? "origin/main" : ref }
  merge_base = git("merge-base", base, "HEAD").strip
  puts "mutant-floor: every subject runs; the baseline is checked against #{base} (#{merge_base[0, 7]})"

  if (problem = MutantFloor.anchor_problem(baseline, base_baseline(merge_base)))
    abort "mutant-floor: #{problem}"
  end

  expressions = YAML.load_file("config/mutant.yml").dig("matcher", "subjects")
  verdict = MutantFloor.compare(run_mutant, baseline, expressions:)
  puts

  list "Killed only by a timeout, so tolerated (a slow runner can do this):", verdict.timed_out
  list "FAIL: the tests fail on the code as written:", verdict.broken
  list "FAIL: mutant stopped short of these subjects' mutations:", verdict.partial
  list "FAIL: named in config/mutant.yml or the baseline, but no such subject ran:", verdict.unmatched
  list "FAIL: killed by a test now; re-record the baseline without them:", verdict.killed
  list "FAIL: mutant no longer makes these; re-record the baseline without them:", verdict.vanished
  list "FAIL: #{verdict.new_survivors.size} new survivor(s), not in #{MutantFloor::BASELINE}:", verdict.new_survivors

  if verdict.pass?
    puts "mutant-floor: the survivors are the baseline's"
  else
    exit 1
  end
end
