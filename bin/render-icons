#!/usr/bin/env ruby
# Rasterises public/icon.svg into the PNGs that platforms will not take an SVG
# for. Run after editing the icon, then commit the PNGs.
#
#   bin/render-icons
#
# The SVG is the source of truth and the only file with the drawing in it. iOS
# ignores SVG icons entirely, and a web app manifest wants raster, so these two
# exist purely as exports:
#
#   icon.png              512  the manifest, Android home screens
#   apple-touch-icon.png  180  iOS home screens
#
# The SVG carries a prefers-color-scheme rule; a PNG cannot, so the exports are
# the light rendering. That is correct for the platforms that use them, which
# put the icon on their own background rather than in a tab.

require "fileutils"

SOURCE = File.expand_path("../public/icon.svg", __dir__)
EXPORTS = { "icon.png" => 512, "apple-touch-icon.png" => 180 }.freeze

RENDERERS = [
  ->(size, out) { [ "rsvg-convert", "-w", size.to_s, "-h", size.to_s, SOURCE, "-o", out ] },
  ->(size, out) { [ "magick", "-background", "none", "-density", "384", SOURCE, "-resize", "#{size}x#{size}", out ] },
  ->(size, out) { [ "inkscape", SOURCE, "-w", size.to_s, "-h", size.to_s, "-o", out ] }
].freeze

renderer = RENDERERS.find do |build|
  command = build.call(1, "/dev/null").first
  system("command", "-v", command, out: File::NULL, err: File::NULL)
end

abort "No SVG rasteriser found. Install one: brew install librsvg (or imagemagick, inkscape)." unless renderer

EXPORTS.each do |name, size|
  out = File.expand_path("../public/#{name}", __dir__)
  abort "failed rendering #{name}" unless system(*renderer.call(size, out))
  puts format("  ok    %-22s %4dpx  %5.1f KB", name, size, File.size(out) / 1024.0)
end
