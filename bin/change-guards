#!/usr/bin/env ruby
# Fails a change that switches a check off from inside the code it checks.
# See PRODUCT.md, CI-7.
#
#   bin/change-guards headers [BASE]   a file under app/ or lib/ gained a generator's header
#   bin/change-guards rubocop [BASE]   a file holds more RuboCop disable or todo directives
#
# BASE defaults to $CI_BASE, else origin/main.
require "fileutils"
require "open3"
require_relative "../test/ci/change_guards"

def git(*args, allow_failure: false)
  out, status = Open3.capture2("git", *args, err: File::NULL)
  abort "change-guards: git #{args.join(" ")} failed" unless status.success? || allow_failure
  status.success? ? out : nil
end

FileUtils.chdir File.expand_path("..", __dir__) do
  check, base = ARGV
  base ||= ENV["CI_BASE"].to_s.then { |ref| ref.empty? ? "origin/main" : ref }
  merge_base = git("merge-base", base, "HEAD").strip
  at_base = ->(path) { git("show", "#{merge_base}:#{path}", allow_failure: true) }

  case check
  when "headers"
    # Each file under app/ or lib/ added, changed or renamed since the base,
    # with its text at the base under its old name.
    pairs = git("diff", "--name-status", "-M", "--diff-filter=AMR", merge_base, "--", "app", "lib").lines.map do |line|
      _status, *paths = line.chomp.split("\t")
      [ paths.last, at_base.(paths.first), File.read(paths.last) ]
    end
    found = ChangeGuards.new_headers(pairs)
    found.each { |path| puts "FAIL: #{path} gained a generator's header, which takes it out of both exhale floors" }
  when "rubocop"
    candidates = ->(*tree) { git("grep", "-l", "-E", "rubocop[[:space:]]*:", *tree, allow_failure: true).to_s.lines.map { |l| l.chomp.delete_prefix("#{merge_base}:") } }
    base_texts = candidates.(merge_base).to_h { |path| [ path, at_base.(path) ] }
    head_texts = candidates.().to_h { |path| [ path, File.read(path) ] }
    found = ChangeGuards.added_directives(base_texts, head_texts)
    found.each { |path, before, after| puts "FAIL: #{path} has #{after} RuboCop disable or todo directive(s), #{before} at the base" }
  else
    abort "usage: bin/change-guards headers|rubocop [BASE]"
  end

  puts "change-guards: #{check}: nothing new since #{base} (#{merge_base[0, 7]})" if found.empty?
  exit(found.empty? ? 0 : 1)
end
