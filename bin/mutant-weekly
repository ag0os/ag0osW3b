#!/usr/bin/env ruby
# The weekly mutation run on main: runs every subject in config/mutant.yml and
# reports the survivors that neither the newest anchor in
# test/mutant/baseline.yml records nor test/mutant/accepted.yml accepts. It
# only reports; it never gates. See docs/contracts/ci.md, CI-10 to CI-12.
#
#   bin/mutant-weekly                  run every subject, write the report and print it, with the issue calls it would make
#   bin/mutant-weekly --session FILE   the same, from a session result mutant already wrote
#   bin/mutant-weekly --issue          open, update or close the mutation-weekly issue through `gh`, from the report
#                                      the run above wrote (the workflow; needs GH_TOKEN)
require "fileutils"
require "json"
require "open3"
require_relative "../test/ci/mutant_weekly"

APP_ROOT = File.expand_path("..", __dir__)
LOG = "log/mutant-weekly.log"
BODY = "log/mutant-weekly.md"
STATE = "log/mutant-weekly.json"

def load_yaml(path)
  document, problem = MutantFloor.parse_yaml(File.exist?(path) ? File.read(path) : nil, path)
  abort "mutant-weekly: #{problem}" if problem
  document || {}
end

# Runs a command, logging what it printed. Returns [output, success].
def logged(env, *command)
  output, status = Open3.capture2e(env, *command)
  File.write(LOG, "=== #{command.join(" ")}\n#{output}\n", mode: "a")
  [ output, status.success? ]
end

# Runs mutant on every subject. Returns [session, wall-clock seconds].
def run_mutant
  _, ok = logged({ "RAILS_ENV" => "test" }, "bin/rails", "db:test:prepare")
  abort "mutant-weekly: bin/rails db:test:prepare failed (#{LOG})" unless ok
  started = Process.clock_gettime(Process::CLOCK_MONOTONIC)
  before = Dir[".mutant/results/*.json"]
  output, = logged({}, "bundle", "exec", "mutant", "run")
  session = (Dir[".mutant/results/*.json"] - before).first
  abort "#{output}\nmutant-weekly: mutant wrote no session result (#{LOG})" unless session
  [ JSON.parse(File.read(session)), Process.clock_gettime(Process::CLOCK_MONOTONIC) - started ]
end

def gh(*args)
  output, status = Open3.capture2e("gh", *args)
  abort "#{output}\nmutant-weekly: gh #{args.join(" ")} failed" unless status.success?
  output
end

def report(session_path)
  session, wall = session_path ? [ JSON.parse(File.read(session_path)), nil ] : run_mutant
  trouble = MutantWeekly.trouble(session, expressions: load_yaml("config/mutant.yml").dig("matcher", "subjects") || [])
  abort trouble.map { |problem| "mutant-weekly: the run can't be reported on: #{problem}" }.join("\n") unless trouble.empty?

  at = Open3.capture2("git", "rev-parse", "--short", "HEAD").first.strip
  found = MutantWeekly.report(session, baseline: load_yaml(MutantFloor::BASELINE), accepted: load_yaml(MutantFloor::ACCEPTED), at:, wall:)
  File.write(BODY, found.body)
  File.write(STATE, JSON.dump("at" => at, "delta" => found.delta.size))
  puts found.body, ""
  { "with no issue open" => [], "with issue #1 open" => [ 1 ] }.each do |state, open|
    commands = MutantWeekly.issue_commands(open:, labelled: false, delta_size: found.delta.size, body_file: BODY, at:)
    puts "mutant-weekly: #{state}, --issue would run:", *(commands.empty? ? [ "  nothing" ] : commands.map { |command| "  gh #{command.join(" ")}" })
  end
end

def issue
  state = JSON.parse(File.read(STATE))
  open = JSON.parse(gh("issue", "list", "--label", MutantWeekly::LABEL, "--state", "open", "--json", "number")).map { |issue| issue["number"] }
  labelled = JSON.parse(gh("label", "list", "--search", MutantWeekly::LABEL, "--json", "name")).any? { |label| label["name"] == MutantWeekly::LABEL }
  MutantWeekly.issue_commands(open:, labelled:, delta_size: state.fetch("delta"), body_file: BODY, at: state.fetch("at")).each do |command|
    puts "mutant-weekly: gh #{command.first(3).join(" ")}"
    gh(*command)
  end
end

FileUtils.chdir APP_ROOT do
  FileUtils.mkdir_p(File.dirname(LOG))
  next issue if ARGV.first == "--issue"

  File.write(LOG, "")
  report(ARGV.first == "--session" ? ARGV.fetch(1) : nil)
end
