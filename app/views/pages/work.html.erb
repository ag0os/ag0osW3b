<% content_for :title, "Work · #{SiteSetting["site_title"]}" %>

<div class="container stack page">
  <header class="page__header railed enter">
    <h1>Work</h1>
    <p class="muted">Most of my product work is private. Here's the public proof.</p>
  </header>

  <% if @sections.any? %>
    <% @sections.each do |section| %>
      <%= render "shared/section", section: section %>
    <% end %>
  <% else %>
    <p class="muted rail-indent">Projects coming soon.</p>
  <% end %>
</div>
