<%# A page's visible sections in order, or its empty state when it has none. %>
<% if sections.any? %>
  <% sections.each do |section| %>
    <%= render "shared/section", section: section %>
  <% end %>
<% else %>
  <%= tag.p copy_text(empty_key), class: "muted rail-indent", lang: copy_lang(empty_key) %>
<% end %>
