<% heading = t("consulting.heading") %>
<% content_for :title, "#{heading} · #{SiteSetting["site_title"]}" %>
<% content_for :description, unmarked(@sections.find { |section| section.key == "consulting_intro" }&.localized(:body)).squish %>

<div class="container stack page">
  <header class="page__header railed enter">
    <h1><%= heading %></h1>
  </header>

  <% @sections.each do |section| %>
    <%= render "shared/section", section: section %>
  <% end %>

  <p class="prose rail-indent"><%= t("consulting.contact_html", linkedin_link: link_to("LinkedIn", SiteSetting["linkedin_url"], target: "_blank", rel: "noopener")) %></p>
</div>
