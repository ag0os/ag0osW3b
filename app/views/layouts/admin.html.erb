<!DOCTYPE html>
<html lang="en" data-theme="<%= SiteSetting.theme_preset %>">
  <head>
    <title><%= content_for(:title).presence || "Admin" %> · Admin</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex,nofollow">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# Same pre-paint script as the public layout: the admin shares the
        visitor's stored preset and mode, so /admin never contradicts the
        surface you were just looking at. %>
    <script>
      (function () {
        var el = document.documentElement;
        var presets = <%= raw SiteSetting::PRESETS.to_json %>;
        el.classList.add("js");
        try {
          var theme = localStorage.getItem("theme");
          if (presets.indexOf(theme) !== -1) el.dataset.theme = theme;
          var mode = localStorage.getItem("mode");
          if (mode === "light" || mode === "dark") el.dataset.mode = mode;
        } catch (e) {}
      })();
    </script>

    <%= stylesheet_link_tag "themes", "application", "components", "admin", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="admin">
    <header class="admin-header">
      <div class="admin-header__inner">
        <%= link_to "Admin", admin_root_path, class: "brand" %>
        <nav class="admin-nav" aria-label="Admin">
          <%= link_to "Dashboard", admin_root_path %>
          <%= link_to "Posts", admin_posts_path %>
          <%= link_to "Sections", admin_sections_path %>
          <%= link_to "Settings", admin_site_settings_path %>
          <%= link_to "View site ↗", root_path, target: "_blank", rel: "noopener" %>
        </nav>
        <%= render "shared/theme_controls" %>
        <%= button_to "Sign out", session_path, method: :delete, class: "btn btn--ghost btn--sm" %>
      </div>
    </header>

    <main class="admin-main container" id="main">
      <%= render "shared/flash" %>
      <%= yield %>
    </main>
  </body>
</html>
