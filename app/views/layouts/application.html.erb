<!DOCTYPE html>
<html lang="en" data-theme="<%= SiteSetting.theme_preset %>">
  <%
    page_title = content_for(:title).presence || SiteSetting["site_title"]
    # unmarked: the tagline carries ==marks== for the hero, and a link preview
    # takes text, not markup.
    page_description = unmarked(content_for(:description).presence || SiteSetting["tagline"])
    canonical_url = request.base_url + request.path
  %>
  <head>
    <title><%= page_title %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="<%= page_description %>">
    <link rel="canonical" href="<%= canonical_url %>">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# Link previews. Without these, a post shared into Slack or LinkedIn
        renders as a bare URL, which is most of how writing actually travels. %>
    <meta property="og:type" content="<%= content_for(:og_type).presence || "website" %>">
    <meta property="og:site_name" content="<%= SiteSetting["site_title"] %>">
    <meta property="og:title" content="<%= page_title %>">
    <meta property="og:description" content="<%= page_description %>">
    <meta property="og:url" content="<%= canonical_url %>">
    <meta name="twitter:card" content="summary">

    <link rel="alternate" type="application/atom+xml"
          title="Writing by <%= SiteSetting["site_title"] %>" href="<%= feed_url %>">

    <%# Applies the visitor's saved preset and mode before first paint.
        data-theme always has a server-rendered value (the site default).
        data-mode is only ever set when the visitor has chosen one, so with
        JavaScript off the OS preference decides via a media query in
        themes.css, and nobody gets a surface they did not ask for.

        nonce: true carries a CSP nonce whenever one is configured. Nothing is
        enforced today, but this script is the whole theming layer: under a
        policy that blocks it, data-theme never restores and the `js` class is
        never added, so the switcher silently disappears while every route
        still returns 200. %>
    <%= javascript_tag nonce: true do %>
      (function () {
        var el = document.documentElement;
        var presets = <%= raw SiteSetting::PRESETS.to_json %>;
        el.classList.add("js");
        try {
          var theme = localStorage.getItem("theme");
          if (presets.indexOf(theme) !== -1) el.dataset.theme = theme;
          var mode = localStorage.getItem("mode");
          if (mode === "light" || mode === "dark") el.dataset.mode = mode;
        } catch (e) {}
      })();
    <% end %>

    <%= yield :head %>

    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= stylesheet_link_tag "themes", "fonts", "application", "components", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="site">
    <a class="skip-link" href="#main">Skip to content</a>
    <%= render "shared/header" %>
    <main class="site-main" id="main">
      <%= render "shared/flash" %>
      <%= yield %>
    </main>
    <%= render "shared/footer" %>
  </body>
</html>
