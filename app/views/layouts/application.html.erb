<!DOCTYPE html>
<html lang="en" data-theme="<%= SiteSetting.theme_preset %>">
  <head>
    <title><%= content_for(:title).presence || SiteSetting["site_title"] %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="<%= content_for(:description).presence || SiteSetting["tagline"] %>">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# Applies the visitor's saved preset and mode before first paint.
        data-theme always has a server-rendered value (the site default).
        data-mode is only ever set when the visitor has chosen one, so with
        JavaScript off the OS preference decides via a media query in
        themes.css, and nobody gets a surface they did not ask for. %>
    <script>
      (function () {
        var el = document.documentElement;
        var presets = <%= raw SiteSetting::PRESETS.to_json %>;
        el.classList.add("js");
        try {
          var theme = localStorage.getItem("theme");
          if (presets.indexOf(theme) !== -1) el.dataset.theme = theme;
          var mode = localStorage.getItem("mode");
          if (mode === "light" || mode === "dark") el.dataset.mode = mode;
        } catch (e) {}
      })();
    </script>

    <%= yield :head %>

    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= stylesheet_link_tag "themes", "application", "components", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="site">
    <a class="skip-link" href="#main">Skip to content</a>
    <%= render "shared/header" %>
    <main class="site-main" id="main">
      <%= render "shared/flash" %>
      <%= yield %>
    </main>
    <%= render "shared/footer" %>
  </body>
</html>
