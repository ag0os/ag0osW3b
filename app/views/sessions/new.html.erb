<% content_for :title, "Sign in" %>

<div class="container auth">
  <h1>Sign in</h1>

  <%= form_with url: session_path, class: "form" do |form| %>
    <label class="field">
      <span>Email</span>
      <%= form.email_field :email_address, required: true, autofocus: true,
            autocomplete: "username", value: params[:email_address] %>
    </label>
    <label class="field">
      <span>Password</span>
      <%= form.password_field :password, required: true,
            autocomplete: "current-password", maxlength: 72 %>
    </label>
    <%= form.submit "Sign in", class: "btn btn--primary" %>
  <% end %>

  <p class="muted"><%= link_to "Forgot password?", new_password_path %></p>
</div>
