<% content_for :title, "Settings" %>

<h1>Settings</h1>
<p class="muted">Site-wide values used across the header, footer, and metadata.</p>

<%= form_with url: admin_site_settings_path, method: :patch, class: "form" do %>
  <% @settings.each do |key, value| %>
    <label class="field">
      <span><%= key.titleize %></span>
      <% if key == "theme_preset" %>
        <%= select_tag "settings[#{key}]",
              options_for_select(SiteSetting::PRESETS.map { |p| [ SiteSetting::PRESET_LABELS[p], p ] }, value) %>
      <% else %>
        <%= text_field_tag "settings[#{key}]", value, class: ("mono" if key.end_with?("url", "email")) %>
      <% end %>
    </label>
  <% end %>

  <p class="form-hint">
    The theme preset is the design visitors see first. They can switch to any of
    the others from the header, and their choice is remembered on their device.
  </p>

  <div class="form-actions">
    <%= submit_tag "Save settings", class: "btn btn--primary" %>
  </div>
<% end %>
