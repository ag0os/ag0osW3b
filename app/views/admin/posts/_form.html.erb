<%= form_with model: [:admin, post], class: "form" do |form| %>
  <%= render "admin/shared/errors", record: post %>

  <label class="field">
    <span>Title</span>
    <%= form.text_field :title %>
  </label>

  <div class="field-row">
    <label class="field">
      <span>Slug</span>
      <%= form.text_field :slug, placeholder: "auto-generated from title if blank", class: "mono" %>
    </label>
    <label class="field">
      <span>Status</span>
      <%= form.select :status, Post.statuses.keys.map { |s| [s.titleize, s] } %>
    </label>
  </div>

  <label class="field">
    <span>Tags</span>
    <%= form.text_field :tags, placeholder: "comma, separated" %>
  </label>

  <label class="field">
    <span>Excerpt</span>
    <%= form.text_area :excerpt, rows: 2 %>
  </label>

  <%= render "admin/shared/markdown_body", form: form, hint: "Markdown", rows: 20 %>

  <%= render "admin/shared/form_actions", form: form, cancel_path: admin_posts_path %>
<% end %>
