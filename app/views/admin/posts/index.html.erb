<% content_for :title, "Posts" %>

<div class="admin-toolbar">
  <h1>Posts</h1>
  <%= link_to "+ New post", new_admin_post_path, class: "btn btn--primary btn--sm" %>
</div>

<% if @posts.any? %>
  <table class="table">
    <thead><tr><th>Title</th><th>Slug</th><th>Status</th><th>Published</th><th></th></tr></thead>
    <tbody>
      <% @posts.each do |post| %>
        <tr>
          <td><%= link_to post.title, edit_admin_post_path(post) %></td>
          <td class="muted mono"><%= post.slug %></td>
          <td><span class="badge badge--<%= post.status %>"><%= post.status %></span></td>
          <td class="muted"><%= post.published_at&.strftime("%b %-d, %Y") || "—" %></td>
          <td class="row-actions">
            <%= link_to "Edit", edit_admin_post_path(post) %>
            <% if post.published? %><%= link_to "View", post_path(post), target: "_blank" %><% end %>
            <%= button_to "Delete", admin_post_path(post), method: :delete,
                  class: "btn-link btn-link--danger",
                  form: { data: { turbo_confirm: "Delete “#{post.title}”?" } } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p class="muted">No posts yet. <%= link_to "Write your first one", new_admin_post_path %>.</p>
<% end %>
