<% if posts.empty? %>
  <p class="shell__muted"><%= t("shell.writing.empty") %></p>
<% else %>
  <ul class="shell__list">
    <% posts.each do |post| %>
      <li><span class="shell__muted"><%= post.published_at.strftime("%Y-%m-%d") %></span> <%= link_to post.title, post_path(post) %></li>
    <% end %>
  </ul>
  <p><%= link_to t("shell.writing.all"), posts_path %></p>
<% end %>
