<%# The shell: the front door of the site. See SHELL.md.

    The transcript is server-rendered in full, opening included, so a visitor
    without JavaScript reads the same session everyone else sees typed out.
    The form submits with GET to /shell; with JavaScript, Turbo asks for a
    stream and the answer is appended below; without it, the home page comes
    back with the exchange after the opening.

    role="log" with polite announcements: appended output is read out after
    the visitor finishes typing, which is when they want it.

    The <template> is the exchange the browser clones for the commands it
    answers itself, so the markup for a line exists in exactly one place. %>
<div class="shell" id="shell"
     data-controller="shell"
     data-shell-commands-value="<%= Shell::COMMANDS.to_json %>"
     data-shell-pages-value="<%= shell_pages.to_json %>"
     data-shell-presets-value="<%= SiteSetting::PRESETS.to_json %>"
     data-shell-strings-value="<%= shell_strings.to_json %>"
     data-action="click->shell#focus">
  <div class="shell__output" id="shell-output" role="log" aria-live="polite" data-shell-target="output">
    <% opening.each do |result| %>
      <%= render "shell/exchange", result: result, opening: true %>
    <% end %>
    <% exchanges.each do |result| %>
      <%= render "shell/exchange", result: result %>
    <% end %>
  </div>

  <%= form_with url: shell_path, method: :get, class: "shell__form",
        data: { turbo_stream: true, shell_target: "form",
                action: "submit->shell#submit turbo:submit-start->shell#submitted turbo:submit-end->shell#settled" } do %>
    <span class="shell__prompt" aria-hidden="true"><%= t("shell.prompt") %></span>
    <input type="text" name="line" id="shell-line" class="shell__input"
           autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false"
           maxlength="<%= Shell::MAX_LENGTH %>" enterkeyhint="send"
           placeholder="<%= t("shell.placeholder") %>" aria-label="<%= t("shell.label") %>"
           data-shell-target="input" data-action="keydown->shell#keydown">
    <button type="submit" class="visually-hidden"><%= t("shell.run") %></button>
  <% end %>

  <template data-shell-target="template">
    <%= render "shell/exchange", result: Shell::Result.new(line: "", view: :message, locals: { text: "" }) %>
  </template>
</div>
