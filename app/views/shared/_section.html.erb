<%# Everything that annotates the section shares one rail cell: the preset's
    marker and the author's margin note. They have to be one element rather
    than two siblings, because grid auto-placement never moves backwards, so a
    second .rail child would be pushed to the row below the prose instead of
    sitting beside the heading it belongs to.

    The marker is a span rather than a pseudo-element on the h2 because
    generated content counts toward the accessible name: as a ::before it made
    the heading announce "CH.01 What I do" in console and "$ What I do" in
    terminal, so a cosmetic preference changed heading semantics. Rendered
    unconditionally in all four presets; workshop resolves it to display: none.

    Each field shows in the page's language, and one with no Spanish yet shows
    its English marked lang="en", so a screen reader reads it as English. %>
<% heading, note = section.localized(:heading), section.localized(:note) %>
<section class="section railed" id="<%= section.key %>">
  <% if heading.present? || note.present? %>
    <div class="rail">
      <span class="section__marker" aria-hidden="true"></span>
      <% if note.present? %>
        <%= tag.p note, class: "note", lang: ("en" if section.untranslated?(:note)) %>
      <% end %>
    </div>
  <% end %>
  <% if heading.present? %>
    <%= tag.h2 heading, class: "section__heading", lang: ("en" if section.untranslated?(:heading)) %>
  <% end %>
  <%= tag.div localized_links(markdown(section.localized(:body))), class: "prose", lang: ("en" if section.untranslated?(:body)) %>
</section>
