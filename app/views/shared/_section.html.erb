<%# The marker is a sibling of the heading, not a child of it, so it can sit in
    the rail. Keeping it out of the heading is also what keeps it out of the
    accessible name: generated content counts toward that name, so as a
    pseudo-element on the h2 it made the heading announce differently in every
    preset. Rendered unconditionally in all four; workshop resolves it to
    display: none. %>
<section class="section railed" id="<%= section.key %>">
  <% if section.heading.present? %>
    <span class="section__marker rail" aria-hidden="true"></span>
    <h2 class="section__heading"><%= section.heading %></h2>
  <% end %>
  <div class="prose">
    <%= markdown(section.body) %>
  </div>
</section>
