<% content_for :title, "#{t("nav.writing")} · #{SiteSetting["site_title"]}" %>

<div class="container stack page">
  <%= render "shared/page_header", title: t("nav.writing"), intro_key: "writing_intro" %>

  <% if @posts.any? %>
    <ul class="post-list">
      <% @posts.each do |post| %>
        <li class="post-list__item railed">
          <time class="post-list__date rail" datetime="<%= post.published_at&.iso8601 %>">
            <%= l(post.published_at, format: :list) %>
          </time>
          <%= link_to post.title, post_path(post), class: "post-list__title" %>
          <% if post.excerpt.present? %>
            <p class="post-list__excerpt"><%= post.excerpt %></p>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <%= tag.p copy_text("writing_empty"), class: "muted rail-indent", lang: copy_lang("writing_empty") %>
  <% end %>
</div>
