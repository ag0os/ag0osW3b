<% content_for :title, "#{@post.title} · #{SiteSetting["site_title"]}" %>
<% content_for :description, @post.excerpt if @post.excerpt.present? %>
<% content_for :og_type, "article" %>

<%# Flat rather than wrapped in a <header>: the meta has to be a direct child
    of the rail grid to reach the margin, and the title, body and footer all
    have to share one text column. %>
<article class="container post railed enter">
  <p class="post__meta rail">
    <time datetime="<%= @post.published_at&.iso8601 %>">
      <%= @post.published_at&.strftime("%B %-d, %Y") %>
    </time>
    <% @post.tag_list.each do |tag| %><span class="tag"><%= tag %></span><% end %>
  </p>

  <h1 class="post__title"><%= @post.title %></h1>

  <div class="prose">
    <%= markdown(@post.body) %>
  </div>

  <footer class="post__footer">
    <%= link_to "← All writing", posts_path, class: "link-more" %>
  </footer>
</article>
