<%# The note comes first so it lands in the rail's first row, beside the
    title rather than below the shell.

    The hero is the tagline and the shell. There is no lead paragraph and no
    button row any more: the shell's opening says who this is and prints the
    email, and the nav is a line above. See SHELL.md. %>
<section class="hero container railed enter">
  <% if SiteSetting.localized("hero_note").present? %>
    <p class="note rail"><%= SiteSetting.localized("hero_note") %></p>
  <% end %>
  <h1 class="hero__title"><%= marked(SiteSetting.localized("tagline")) %></h1>
  <%= render "shell/shell", opening: @opening, exchanges: @exchanges %>
</section>

<div class="container stack">
  <% @sections.each do |section| %>
    <%= render "shared/section", section: section %>
  <% end %>

  <% if @recent_posts.any? %>
    <section class="section railed">
      <div class="rail">
        <span class="section__marker" aria-hidden="true"></span>
      </div>
      <h2 class="section__heading"><%= t("home.writing") %></h2>
      <ul class="post-list">
        <% @recent_posts.each do |post| %>
          <li class="post-list__item railed">
            <time class="post-list__date rail" datetime="<%= post.published_at&.iso8601 %>">
              <%= post.published_at&.strftime("%b %-d, %Y") %>
            </time>
            <%= link_to post.title, post_path(post), class: "post-list__title" %>
          </li>
        <% end %>
      </ul>
      <%= link_to t("home.all_writing"), posts_path, class: "link-more" %>
    </section>
  <% end %>
</div>
